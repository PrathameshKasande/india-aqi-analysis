		annotation SummarizationSetBy = Automatic

	column aqi_value
		dataType: int64
		formatString: 0
		lineageTag: d3543a3b-8450-4694-b8e1-4f32806280da
		summarizeBy: sum
		sourceColumn: aqi_value

		annotation SummarizationSetBy = Automatic

	column air_quality_status
		dataType: string
		lineageTag: 9a20bf16-e490-4f8e-a995-1694ecd12810
		summarizeBy: none
		sourceColumn: air_quality_status

		annotation SummarizationSetBy = Automatic

	column unit
		dataType: string
		lineageTag: 6d15569c-5e3b-4253-b5d2-2a9b615f8d6b
		summarizeBy: none
		sourceColumn: unit

		annotation SummarizationSetBy = Automatic

	column Avg_PM25 = CALCULATE(AVERAGE('cleaned_aqi'[aqi_value]), CONTAINSSTRING('cleaned_aqi'[prominent_pollutants], "PM2.5"))
		lineageTag: e0448834-bbd2-4a45-acc5-2a078023ce83
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition cleaned_aqi = m
