		dataType: dateTime
		formatString: Long Date
		lineageTag: 484985eb-46f7-4230-8de2-2c5cc341054b
		summarizeBy: none
		sourceColumn: date

		variation Variation
			isDefault
			relationship: aebfb619-1e99-4fd2-8cc0-2e147391aa43
			defaultHierarchy: LocalDateTable_073ccd81-c1e4-4af3-898b-3278e3d514b0.'Date Hierarchy'

