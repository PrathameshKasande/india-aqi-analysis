				  Source = Csv.Document(File.Contents("C:\Users\prath\Desktop\india-aqi-analysis\data\processed\cleaned_aqi.csv"), [Delimiter = ",", Columns = 8, Encoding = 65001]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
